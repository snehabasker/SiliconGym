VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN popcount_w6 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 12 ;
    - _09_ sky130_fd_sc_hd__inv_1 + PLACED ( 10120 5440 ) FS ;
    - _10_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 7820 13600 ) N ;
    - _11_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 5520 10880 ) FS ;
    - _12_ sky130_fd_sc_hd__xor2_1 + PLACED ( 8280 8160 ) N ;
    - _13_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 11500 8160 ) N ;
    - _14_ sky130_fd_sc_hd__nor2_1 + PLACED ( 11500 5440 ) FS ;
    - _15_ sky130_fd_sc_hd__maj3_1 + PLACED ( 4140 13600 ) N ;
    - _16_ sky130_fd_sc_hd__maj3_1 + PLACED ( 9660 10880 ) FS ;
    - _17_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 13340 10880 ) FS ;
    - _18_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 14720 8160 ) N ;
    - _19_ sky130_fd_sc_hd__maj3_1 + PLACED ( 13340 13600 ) N ;
    - _20_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 6900 5440 ) FS ;
END COMPONENTS
PINS 9 ;
    - count[0] + NET count[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - count[1] + NET count[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 17710 242 ) N ;
    - count[2] + NET count[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 19550 23757 ) N ;
    - in[0] + NET in[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 18020 ) N ;
    - in[1] + NET in[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 12580 ) N ;
    - in[2] + NET in[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 8510 242 ) N ;
    - in[3] + NET in[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 1150 23757 ) N ;
    - in[4] + NET in[4] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 10350 23757 ) N ;
    - in[5] + NET in[5] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 4420 ) N ;
END PINS
NETS 18 ;
    - _00_ ( _14_ A ) ( _09_ Y ) + USE SIGNAL ;
    - _01_ ( _11_ B ) ( _10_ Y ) + USE SIGNAL ;
    - _02_ ( _16_ C ) ( _12_ B ) ( _11_ Y ) + USE SIGNAL ;
    - _03_ ( _13_ B ) ( _12_ X ) + USE SIGNAL ;
    - _04_ ( _20_ B ) ( _14_ B ) ( _13_ Y ) + USE SIGNAL ;
    - _05_ ( _19_ A ) ( _18_ A ) ( _14_ Y ) + USE SIGNAL ;
    - _06_ ( _19_ B ) ( _17_ A ) ( _15_ X ) + USE SIGNAL ;
    - _07_ ( _19_ C ) ( _17_ B ) ( _16_ X ) + USE SIGNAL ;
    - _08_ ( _18_ B ) ( _17_ Y ) + USE SIGNAL ;
    - count[0] ( PIN count[0] ) ( _20_ Y ) + USE SIGNAL ;
    - count[1] ( PIN count[1] ) ( _18_ Y ) + USE SIGNAL ;
    - count[2] ( PIN count[2] ) ( _19_ X ) + USE SIGNAL ;
    - in[0] ( PIN in[0] ) ( _15_ A ) ( _10_ A ) + USE SIGNAL ;
    - in[1] ( PIN in[1] ) ( _15_ B ) ( _10_ B ) + USE SIGNAL ;
    - in[2] ( PIN in[2] ) ( _20_ A ) ( _09_ A ) + USE SIGNAL ;
    - in[3] ( PIN in[3] ) ( _15_ C ) ( _11_ A ) + USE SIGNAL ;
    - in[4] ( PIN in[4] ) ( _16_ A ) ( _12_ A ) + USE SIGNAL ;
    - in[5] ( PIN in[5] ) ( _16_ B ) ( _13_ A ) + USE SIGNAL ;
END NETS
END DESIGN
