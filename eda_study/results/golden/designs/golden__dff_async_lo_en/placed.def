VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN dff_async_lo_en ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 26000 26000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 47 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 47 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 47 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 47 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 47 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 47 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 47 BY 1 STEP 460 0 ;
TRACKS X 230 DO 57 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 76 STEP 340 LAYER li1 ;
TRACKS X 170 DO 76 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 76 STEP 340 LAYER met1 ;
TRACKS X 230 DO 57 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 57 STEP 460 LAYER met2 ;
TRACKS X 340 DO 38 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 38 STEP 680 LAYER met3 ;
TRACKS X 460 DO 28 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 28 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 8 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 8 STEP 3400 LAYER met5 ;
COMPONENTS 11 ;
    - _04_ sky130_fd_sc_hd__mux2_1 + PLACED ( 11500 19040 ) N ;
    - _05_ sky130_fd_sc_hd__mux2_1 + PLACED ( 14720 8160 ) N ;
    - _06_ sky130_fd_sc_hd__mux2_1 + PLACED ( 16100 13600 ) N ;
    - _07_ sky130_fd_sc_hd__mux2_1 + PLACED ( 19780 10880 ) FS ;
    - _08_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 10580 10880 ) FS ;
    - _09_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 5520 8160 ) N ;
    - _10_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 6900 13600 ) N ;
    - _11_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 8280 5440 ) FS ;
    - clkbuf_0_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 8280 16320 ) FS ;
    - clkbuf_1_0__f_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 2300 2720 ) N ;
    - clkbuf_1_1__f_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 2300 19040 ) N ;
END COMPONENTS
PINS 11 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 23460 ) N ;
    - d[0] + NET d[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 23230 242 ) N ;
    - d[1] + NET d[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - d[2] + NET d[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 21390 25757 ) N ;
    - d[3] + NET d[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 15870 242 ) N ;
    - en + NET en + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 11220 ) N ;
    - q[0] + NET q[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 25600 19380 ) N ;
    - q[1] + NET q[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 7590 242 ) N ;
    - q[2] + NET q[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 5750 25757 ) N ;
    - q[3] + NET q[3] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 14030 25757 ) N ;
    - rst_n + NET rst_n + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 25600 8500 ) N ;
END PINS
NETS 18 ;
    - _00_ ( _10_ D ) ( _04_ X ) + USE SIGNAL ;
    - _01_ ( _09_ D ) ( _05_ X ) + USE SIGNAL ;
    - _02_ ( _08_ D ) ( _06_ X ) + USE SIGNAL ;
    - _03_ ( _11_ D ) ( _07_ X ) + USE SIGNAL ;
    - clk ( PIN clk ) ( clkbuf_0_clk A ) + USE CLOCK ;
    - clknet_0_clk ( clkbuf_1_1__f_clk A ) ( clkbuf_1_0__f_clk A ) ( clkbuf_0_clk X ) + USE CLOCK ;
    - clknet_1_0__leaf_clk ( _09_ CLK ) ( _11_ CLK ) ( clkbuf_1_0__f_clk X ) + USE CLOCK ;
    - clknet_1_1__leaf_clk ( _08_ CLK ) ( _10_ CLK ) ( clkbuf_1_1__f_clk X ) + USE CLOCK ;
    - d[0] ( PIN d[0] ) ( _06_ A1 ) + USE SIGNAL ;
    - d[1] ( PIN d[1] ) ( _05_ A1 ) + USE SIGNAL ;
    - d[2] ( PIN d[2] ) ( _04_ A1 ) + USE SIGNAL ;
    - d[3] ( PIN d[3] ) ( _07_ A1 ) + USE SIGNAL ;
    - en ( PIN en ) ( _07_ S ) ( _06_ S ) ( _05_ S ) ( _04_ S ) + USE SIGNAL ;
    - q[0] ( PIN q[0] ) ( _08_ Q ) ( _06_ A0 ) + USE SIGNAL ;
    - q[1] ( PIN q[1] ) ( _09_ Q ) ( _05_ A0 ) + USE SIGNAL ;
    - q[2] ( PIN q[2] ) ( _10_ Q ) ( _04_ A0 ) + USE SIGNAL ;
    - q[3] ( PIN q[3] ) ( _11_ Q ) ( _07_ A0 ) + USE SIGNAL ;
    - rst_n ( PIN rst_n ) ( _11_ RESET_B ) ( _10_ RESET_B ) ( _09_ RESET_B ) ( _08_ RESET_B ) + USE SIGNAL ;
END NETS
END DESIGN
