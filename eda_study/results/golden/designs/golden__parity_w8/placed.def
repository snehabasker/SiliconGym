VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN parity_w8 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 7 ;
    - _06_ sky130_fd_sc_hd__xor2_1 + PLACED ( 7820 16320 ) FS ;
    - _07_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 6440 10880 ) FS ;
    - _08_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 10120 10880 ) FS ;
    - _09_ sky130_fd_sc_hd__xor2_1 + PLACED ( 16560 16320 ) FS ;
    - _10_ sky130_fd_sc_hd__xor2_1 + PLACED ( 15180 5440 ) FS ;
    - _11_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 16560 8160 ) N ;
    - _12_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 16560 10880 ) FS ;
END COMPONENTS
PINS 9 ;
    - in[0] + NET in[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - in[1] + NET in[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 17710 242 ) N ;
    - in[2] + NET in[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 19550 23757 ) N ;
    - in[3] + NET in[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 18020 ) N ;
    - in[4] + NET in[4] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 12580 ) N ;
    - in[5] + NET in[5] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 8510 242 ) N ;
    - in[6] + NET in[6] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 1150 23757 ) N ;
    - in[7] + NET in[7] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 10350 23757 ) N ;
    - p + NET p + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 4420 ) N ;
END PINS
NETS 15 ;
    - _00_ ( _08_ A ) ( _06_ X ) + USE SIGNAL ;
    - _01_ ( _08_ B ) ( _07_ Y ) + USE SIGNAL ;
    - _02_ ( _12_ A ) ( _08_ Y ) + USE SIGNAL ;
    - _03_ ( _11_ A ) ( _09_ X ) + USE SIGNAL ;
    - _04_ ( _11_ B ) ( _10_ X ) + USE SIGNAL ;
    - _05_ ( _12_ B ) ( _11_ Y ) + USE SIGNAL ;
    - in[0] ( PIN in[0] ) ( _10_ A ) + USE SIGNAL ;
    - in[1] ( PIN in[1] ) ( _10_ B ) + USE SIGNAL ;
    - in[2] ( PIN in[2] ) ( _09_ A ) + USE SIGNAL ;
    - in[3] ( PIN in[3] ) ( _09_ B ) + USE SIGNAL ;
    - in[4] ( PIN in[4] ) ( _07_ A ) + USE SIGNAL ;
    - in[5] ( PIN in[5] ) ( _07_ B ) + USE SIGNAL ;
    - in[6] ( PIN in[6] ) ( _06_ A ) + USE SIGNAL ;
    - in[7] ( PIN in[7] ) ( _06_ B ) + USE SIGNAL ;
    - p ( PIN p ) ( _12_ Y ) + USE SIGNAL ;
END NETS
END DESIGN
