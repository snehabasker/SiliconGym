VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN counter_w3 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 13 ;
    - _07_ sky130_fd_sc_hd__and3_1 + PLACED ( 14260 10880 ) FS ;
    - _08_ sky130_fd_sc_hd__a21oi_1 + PLACED ( 16560 10880 ) FS ;
    - _09_ sky130_fd_sc_hd__nor3_1 + PLACED ( 11040 8160 ) N ;
    - _10_ sky130_fd_sc_hd__a41oi_1 + PLACED ( 14260 13600 ) N ;
    - _11_ sky130_fd_sc_hd__o21a_1 + PLACED ( 11500 10880 ) FS ;
    - _12_ sky130_fd_sc_hd__a21oi_1 + PLACED ( 14260 8160 ) N ;
    - _13_ sky130_fd_sc_hd__o21a_1 + PLACED ( 14260 5440 ) FS ;
    - _14_ sky130_fd_sc_hd__dfxtp_1 + PLACED ( 6900 5440 ) FS ;
    - _15_ sky130_fd_sc_hd__dfxtp_1 + PLACED ( 2300 8160 ) N ;
    - _16_ sky130_fd_sc_hd__dfxtp_1 + PLACED ( 5520 16320 ) FS ;
    - clkbuf_0_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 5060 13600 ) N ;
    - clkbuf_1_0__f_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 2300 2720 ) N ;
    - clkbuf_1_1__f_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 2300 10880 ) FS ;
END COMPONENTS
PINS 6 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 19380 ) N ;
    - count[0] + NET count[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 13110 242 ) N ;
    - count[1] + NET count[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - count[2] + NET count[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 10350 23757 ) N ;
    - en + NET en + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 23230 23757 ) N ;
    - rst + NET rst + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 4420 ) N ;
END PINS
NETS 16 ;
    - _00_ ( _15_ D ) ( _09_ Y ) + USE SIGNAL ;
    - _01_ ( _16_ D ) ( _11_ X ) + USE SIGNAL ;
    - _02_ ( _14_ D ) ( _13_ X ) + USE SIGNAL ;
    - _03_ ( _09_ C ) ( _08_ Y ) + USE SIGNAL ;
    - _04_ ( _11_ B1 ) ( _10_ Y ) + USE SIGNAL ;
    - _05_ ( _13_ B1 ) ( _12_ Y ) + USE SIGNAL ;
    - _06_ ( _11_ A2 ) ( _09_ B ) ( _07_ X ) + USE SIGNAL ;
    - clk ( PIN clk ) ( clkbuf_0_clk A ) + USE CLOCK ;
    - clknet_0_clk ( clkbuf_1_1__f_clk A ) ( clkbuf_1_0__f_clk A ) ( clkbuf_0_clk X ) + USE CLOCK ;
    - clknet_1_0__leaf_clk ( _14_ CLK ) ( _15_ CLK ) ( clkbuf_1_0__f_clk X ) + USE CLOCK ;
    - clknet_1_1__leaf_clk ( _16_ CLK ) ( clkbuf_1_1__f_clk X ) + USE CLOCK ;
    - count[0] ( PIN count[0] ) ( _14_ Q ) ( _13_ A1 ) ( _12_ A1 ) ( _10_ A1 ) ( _08_ A1 ) ( _07_ A ) + USE SIGNAL ;
    - count[1] ( PIN count[1] ) ( _15_ Q ) ( _10_ A4 ) ( _08_ B1 ) ( _07_ C ) + USE SIGNAL ;
    - count[2] ( PIN count[2] ) ( _16_ Q ) ( _11_ A1 ) ( _10_ A3 ) + USE SIGNAL ;
    - en ( PIN en ) ( _13_ A2 ) ( _12_ A2 ) ( _10_ A2 ) ( _08_ A2 ) ( _07_ B ) + USE SIGNAL ;
    - rst ( PIN rst ) ( _12_ B1 ) ( _10_ B1 ) ( _09_ A ) + USE SIGNAL ;
END NETS
END DESIGN
