VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN prienc_n8 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 12 ;
    - _08_ sky130_fd_sc_hd__inv_1 + PLACED ( 5520 5440 ) FS ;
    - _09_ sky130_fd_sc_hd__nor2_1 + PLACED ( 5060 8160 ) N ;
    - _10_ sky130_fd_sc_hd__nor2_1 + PLACED ( 11040 5440 ) FS ;
    - _11_ sky130_fd_sc_hd__nor2_1 + PLACED ( 17020 10880 ) FS ;
    - _12_ sky130_fd_sc_hd__o31ai_1 + PLACED ( 9200 8160 ) N ;
    - _13_ sky130_fd_sc_hd__nand2b_1 + PLACED ( 6440 10880 ) FS ;
    - _14_ sky130_fd_sc_hd__a21oi_1 + PLACED ( 7360 8160 ) N ;
    - _15_ sky130_fd_sc_hd__nor2_1 + PLACED ( 14260 8160 ) N ;
    - _16_ sky130_fd_sc_hd__o21bai_1 + PLACED ( 14260 10880 ) FS ;
    - _17_ sky130_fd_sc_hd__nand2_1 + PLACED ( 10580 10880 ) FS ;
    - _18_ sky130_fd_sc_hd__nor2_1 + PLACED ( 3680 8160 ) N ;
    - _19_ sky130_fd_sc_hd__nand4_1 + PLACED ( 11960 8160 ) N ;
END COMPONENTS
PINS 12 ;
    - in[0] + NET in[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 9860 ) N ;
    - in[1] + NET in[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 23230 23757 ) N ;
    - in[2] + NET in[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 19380 ) N ;
    - in[3] + NET in[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - in[4] + NET in[4] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 13110 242 ) N ;
    - in[5] + NET in[5] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 20470 242 ) N ;
    - in[6] + NET in[6] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 16790 23757 ) N ;
    - in[7] + NET in[7] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 13940 ) N ;
    - out[0] + NET out[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 6670 242 ) N ;
    - out[1] + NET out[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 2990 23757 ) N ;
    - out[2] + NET out[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 10350 23757 ) N ;
    - valid + NET valid + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 4420 ) N ;
END PINS
NETS 20 ;
    - _00_ ( _14_ A1 ) ( _08_ Y ) + USE SIGNAL ;
    - _01_ ( _19_ A ) ( _12_ A3 ) ( _09_ Y ) + USE SIGNAL ;
    - _02_ ( _19_ B ) ( _17_ A ) ( _10_ Y ) + USE SIGNAL ;
    - _03_ ( _19_ C ) ( _17_ B ) ( _12_ B1 ) ( _11_ Y ) + USE SIGNAL ;
    - _04_ ( _14_ A2 ) ( _13_ Y ) + USE SIGNAL ;
    - _05_ ( _15_ B ) ( _14_ Y ) + USE SIGNAL ;
    - _06_ ( _16_ A2 ) ( _15_ Y ) + USE SIGNAL ;
    - _07_ ( _19_ D ) ( _18_ Y ) + USE SIGNAL ;
    - in[0] ( PIN in[0] ) ( _18_ B ) + USE SIGNAL ;
    - in[1] ( PIN in[1] ) ( _18_ A ) ( _13_ B ) + USE SIGNAL ;
    - in[2] ( PIN in[2] ) ( _13_ A_N ) ( _09_ A ) + USE SIGNAL ;
    - in[3] ( PIN in[3] ) ( _09_ B ) ( _08_ A ) + USE SIGNAL ;
    - in[4] ( PIN in[4] ) ( _14_ B1 ) ( _12_ A1 ) ( _10_ A ) + USE SIGNAL ;
    - in[5] ( PIN in[5] ) ( _15_ A ) ( _12_ A2 ) ( _10_ B ) + USE SIGNAL ;
    - in[6] ( PIN in[6] ) ( _16_ A1 ) ( _11_ A ) + USE SIGNAL ;
    - in[7] ( PIN in[7] ) ( _16_ B1_N ) ( _11_ B ) + USE SIGNAL ;
    - out[0] ( PIN out[0] ) ( _16_ Y ) + USE SIGNAL ;
    - out[1] ( PIN out[1] ) ( _12_ Y ) + USE SIGNAL ;
    - out[2] ( PIN out[2] ) ( _17_ Y ) + USE SIGNAL ;
    - valid ( PIN valid ) ( _19_ Y ) + USE SIGNAL ;
END NETS
END DESIGN
