VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN decoder_k3 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 8 ;
    - _0_ sky130_fd_sc_hd__and4b_1 + PLACED ( 7360 16320 ) FS ;
    - _1_ sky130_fd_sc_hd__and4b_1 + PLACED ( 3680 16320 ) FS ;
    - _2_ sky130_fd_sc_hd__nor4bb_1 + PLACED ( 4140 5440 ) FS ;
    - _3_ sky130_fd_sc_hd__and4b_1 + PLACED ( 15180 13600 ) N ;
    - _4_ sky130_fd_sc_hd__nor4bb_1 + PLACED ( 13800 16320 ) FS ;
    - _5_ sky130_fd_sc_hd__nor4bb_1 + PLACED ( 15180 5440 ) FS ;
    - _6_ sky130_fd_sc_hd__nor4b_1 + PLACED ( 11960 5440 ) FS ;
    - _7_ sky130_fd_sc_hd__and4_1 + PLACED ( 15640 2720 ) N ;
END COMPONENTS
PINS 12 ;
    - en + NET en + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 9860 ) N ;
    - in[0] + NET in[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 23230 23757 ) N ;
    - in[1] + NET in[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 19380 ) N ;
    - in[2] + NET in[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - out[0] + NET out[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 13110 242 ) N ;
    - out[1] + NET out[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 20470 242 ) N ;
    - out[2] + NET out[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 16790 23757 ) N ;
    - out[3] + NET out[3] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 13940 ) N ;
    - out[4] + NET out[4] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 6670 242 ) N ;
    - out[5] + NET out[5] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 2990 23757 ) N ;
    - out[6] + NET out[6] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 10350 23757 ) N ;
    - out[7] + NET out[7] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 4420 ) N ;
END PINS
NETS 12 ;
    - en ( PIN en ) ( _7_ C ) ( _6_ D_N ) ( _5_ C_N ) ( _4_ C_N ) ( _3_ B ) ( _2_ C_N )
      ( _1_ C ) ( _0_ B ) + USE SIGNAL ;
    - in[0] ( PIN in[0] ) ( _7_ B ) ( _6_ B ) ( _5_ D_N ) ( _4_ A ) ( _3_ C ) ( _2_ B )
      ( _1_ B ) ( _0_ A_N ) + USE SIGNAL ;
    - in[1] ( PIN in[1] ) ( _7_ A ) ( _6_ A ) ( _5_ A ) ( _4_ D_N ) ( _3_ D ) ( _2_ A )
      ( _1_ A_N ) ( _0_ D ) + USE SIGNAL ;
    - in[2] ( PIN in[2] ) ( _7_ D ) ( _6_ C ) ( _5_ B ) ( _4_ B ) ( _3_ A_N ) ( _2_ D_N )
      ( _1_ D ) ( _0_ C ) + USE SIGNAL ;
    - out[0] ( PIN out[0] ) ( _6_ Y ) + USE SIGNAL ;
    - out[1] ( PIN out[1] ) ( _5_ Y ) + USE SIGNAL ;
    - out[2] ( PIN out[2] ) ( _4_ Y ) + USE SIGNAL ;
    - out[3] ( PIN out[3] ) ( _3_ X ) + USE SIGNAL ;
    - out[4] ( PIN out[4] ) ( _2_ Y ) + USE SIGNAL ;
    - out[5] ( PIN out[5] ) ( _1_ X ) + USE SIGNAL ;
    - out[6] ( PIN out[6] ) ( _0_ X ) + USE SIGNAL ;
    - out[7] ( PIN out[7] ) ( _7_ X ) + USE SIGNAL ;
END NETS
END DESIGN
