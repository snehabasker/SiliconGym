VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN dff_async_hi ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 11 ;
    - _04_ sky130_fd_sc_hd__inv_1 + PLACED ( 17480 8160 ) N ;
    - _05_ sky130_fd_sc_hd__inv_1 + PLACED ( 13340 5440 ) FS ;
    - _06_ sky130_fd_sc_hd__inv_1 + PLACED ( 14720 5440 ) FS ;
    - _07_ sky130_fd_sc_hd__inv_1 + PLACED ( 11960 5440 ) FS ;
    - _08_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 8280 8160 ) N ;
    - _09_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 8280 10880 ) FS ;
    - _10_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 8280 13600 ) N ;
    - _11_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 4600 16320 ) FS ;
    - clkbuf_0_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 6900 19040 ) N ;
    - clkbuf_1_0__f_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 2300 2720 ) N ;
    - clkbuf_1_1__f_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 2300 5440 ) FS ;
END COMPONENTS
PINS 10 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 23230 23757 ) N ;
    - d[0] + NET d[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - d[1] + NET d[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 15870 23757 ) N ;
    - d[2] + NET d[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 15870 242 ) N ;
    - d[3] + NET d[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 11220 ) N ;
    - q[0] + NET q[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 12580 ) N ;
    - q[1] + NET q[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 7590 242 ) N ;
    - q[2] + NET q[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 23460 ) N ;
    - q[3] + NET q[3] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 7590 23757 ) N ;
    - rst + NET rst + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 340 ) N ;
END PINS
NETS 17 ;
    - _00_ ( _10_ RESET_B ) ( _04_ Y ) + USE SIGNAL ;
    - _01_ ( _09_ RESET_B ) ( _05_ Y ) + USE SIGNAL ;
    - _02_ ( _08_ RESET_B ) ( _06_ Y ) + USE SIGNAL ;
    - _03_ ( _11_ RESET_B ) ( _07_ Y ) + USE SIGNAL ;
    - clk ( PIN clk ) ( clkbuf_0_clk A ) + USE CLOCK ;
    - clknet_0_clk ( clkbuf_1_1__f_clk A ) ( clkbuf_1_0__f_clk A ) ( clkbuf_0_clk X ) + USE CLOCK ;
    - clknet_1_0__leaf_clk ( _08_ CLK ) ( _09_ CLK ) ( clkbuf_1_0__f_clk X ) + USE CLOCK ;
    - clknet_1_1__leaf_clk ( _10_ CLK ) ( _11_ CLK ) ( clkbuf_1_1__f_clk X ) + USE CLOCK ;
    - d[0] ( PIN d[0] ) ( _08_ D ) + USE SIGNAL ;
    - d[1] ( PIN d[1] ) ( _09_ D ) + USE SIGNAL ;
    - d[2] ( PIN d[2] ) ( _10_ D ) + USE SIGNAL ;
    - d[3] ( PIN d[3] ) ( _11_ D ) + USE SIGNAL ;
    - q[0] ( PIN q[0] ) ( _08_ Q ) + USE SIGNAL ;
    - q[1] ( PIN q[1] ) ( _09_ Q ) + USE SIGNAL ;
    - q[2] ( PIN q[2] ) ( _10_ Q ) + USE SIGNAL ;
    - q[3] ( PIN q[3] ) ( _11_ Q ) + USE SIGNAL ;
    - rst ( PIN rst ) ( _07_ A ) ( _06_ A ) ( _05_ A ) ( _04_ A ) + USE SIGNAL ;
END NETS
END DESIGN
