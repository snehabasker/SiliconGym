VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN satadd_w3 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 11 ;
    - _08_ sky130_fd_sc_hd__nand2_1 + PLACED ( 9200 13600 ) N ;
    - _09_ sky130_fd_sc_hd__nand2_1 + PLACED ( 10120 8160 ) N ;
    - _10_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 6900 8160 ) N ;
    - _11_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 9660 10880 ) FS ;
    - _12_ sky130_fd_sc_hd__nor2_1 + PLACED ( 16100 16320 ) FS ;
    - _13_ sky130_fd_sc_hd__nand2_1 + PLACED ( 12880 13600 ) N ;
    - _14_ sky130_fd_sc_hd__o21a_1 + PLACED ( 6900 10880 ) FS ;
    - _15_ sky130_fd_sc_hd__o211ai_1 + PLACED ( 10580 16320 ) FS ;
    - _16_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 5980 13600 ) N ;
    - _17_ sky130_fd_sc_hd__o211ai_1 + PLACED ( 13340 16320 ) FS ;
    - _18_ sky130_fd_sc_hd__nand2_1 + PLACED ( 14260 13600 ) N ;
END COMPONENTS
PINS 9 ;
    - a[0] + NET a[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - a[1] + NET a[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 17710 242 ) N ;
    - a[2] + NET a[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 19550 23757 ) N ;
    - b[0] + NET b[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 18020 ) N ;
    - b[1] + NET b[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 12580 ) N ;
    - b[2] + NET b[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 8510 242 ) N ;
    - y[0] + NET y[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 1150 23757 ) N ;
    - y[1] + NET y[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 10350 23757 ) N ;
    - y[2] + NET y[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 4420 ) N ;
END PINS
NETS 17 ;
    - _00_ ( _14_ A1 ) ( _11_ A ) ( _08_ Y ) + USE SIGNAL ;
    - _01_ ( _14_ B1 ) ( _09_ Y ) + USE SIGNAL ;
    - _02_ ( _14_ A2 ) ( _11_ B ) ( _10_ Y ) + USE SIGNAL ;
    - _03_ ( _15_ C1 ) ( _11_ Y ) + USE SIGNAL ;
    - _04_ ( _18_ A ) ( _17_ A1 ) ( _15_ A1 ) ( _12_ Y ) + USE SIGNAL ;
    - _05_ ( _17_ C1 ) ( _15_ B1 ) ( _13_ Y ) + USE SIGNAL ;
    - _06_ ( _18_ B ) ( _17_ A2 ) ( _15_ A2 ) ( _14_ X ) + USE SIGNAL ;
    - _07_ ( _17_ B1 ) ( _16_ Y ) + USE SIGNAL ;
    - a[0] ( PIN a[0] ) ( _16_ A ) ( _08_ A ) + USE SIGNAL ;
    - a[1] ( PIN a[1] ) ( _10_ A ) ( _09_ A ) + USE SIGNAL ;
    - a[2] ( PIN a[2] ) ( _13_ A ) ( _12_ A ) + USE SIGNAL ;
    - b[0] ( PIN b[0] ) ( _16_ B ) ( _08_ B ) + USE SIGNAL ;
    - b[1] ( PIN b[1] ) ( _10_ B ) ( _09_ B ) + USE SIGNAL ;
    - b[2] ( PIN b[2] ) ( _13_ B ) ( _12_ B ) + USE SIGNAL ;
    - y[0] ( PIN y[0] ) ( _17_ Y ) + USE SIGNAL ;
    - y[1] ( PIN y[1] ) ( _15_ Y ) + USE SIGNAL ;
    - y[2] ( PIN y[2] ) ( _18_ Y ) + USE SIGNAL ;
END NETS
END DESIGN
