    - y[1] + NET y[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 21390 23757 ) N ;
    - y[2] + NET y[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 8510 242 ) N ;
    - y[3] + NET y[3] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 18020 ) N ;
    - y[4] + NET y[4] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 4830 23757 ) N ;
    - y[5] + NET y[5] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 8500 ) N ;
END PINS
NETS 19 ;
    - d0[0] ( PIN d0[0] ) ( _4_ A0 ) + USE SIGNAL ;
    - d0[1] ( PIN d0[1] ) ( _3_ A0 ) + USE SIGNAL ;
    - d0[2] ( PIN d0[2] ) ( _2_ A0 ) + USE SIGNAL ;
    - d0[3] ( PIN d0[3] ) ( _1_ A0 ) + USE SIGNAL ;
    - d0[4] ( PIN d0[4] ) ( _0_ A0 ) + USE SIGNAL ;
    - d0[5] ( PIN d0[5] ) ( _5_ A0 ) + USE SIGNAL ;
    - d1[0] ( PIN d1[0] ) ( _4_ A1 ) + USE SIGNAL ;
    - d1[1] ( PIN d1[1] ) ( _3_ A1 ) + USE SIGNAL ;
    - d1[2] ( PIN d1[2] ) ( _2_ A1 ) + USE SIGNAL ;
    - d1[3] ( PIN d1[3] ) ( _1_ A1 ) + USE SIGNAL ;
    - d1[4] ( PIN d1[4] ) ( _0_ A1 ) + USE SIGNAL ;
    - d1[5] ( PIN d1[5] ) ( _5_ A1 ) + USE SIGNAL ;
    - sel ( PIN sel ) ( _5_ S ) ( _4_ S ) ( _3_ S ) ( _2_ S ) ( _1_ S ) ( _0_ S ) + USE SIGNAL ;
    - y[0] ( PIN y[0] ) ( _4_ X ) + USE SIGNAL ;
    - y[1] ( PIN y[1] ) ( _3_ X ) + USE SIGNAL ;
    - y[2] ( PIN y[2] ) ( _2_ X ) + USE SIGNAL ;
    - y[3] ( PIN y[3] ) ( _1_ X ) + USE SIGNAL ;
    - y[4] ( PIN y[4] ) ( _0_ X ) + USE SIGNAL ;
    - y[5] ( PIN y[5] ) ( _5_ X ) + USE SIGNAL ;
END NETS
END DESIGN
