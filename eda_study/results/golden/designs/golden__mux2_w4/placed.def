VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN mux2_w4 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 4 ;
    - _0_ sky130_fd_sc_hd__mux2_1 + PLACED ( 8740 16320 ) FS ;
    - _1_ sky130_fd_sc_hd__mux2_1 + PLACED ( 10120 5440 ) FS ;
    - _2_ sky130_fd_sc_hd__mux2_1 + PLACED ( 5980 5440 ) FS ;
    - _3_ sky130_fd_sc_hd__mux2_1 + PLACED ( 12880 16320 ) FS ;
END COMPONENTS
PINS 13 ;
    - d0[0] + NET d0[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 9860 ) N ;
    - d0[1] + NET d0[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 12190 242 ) N ;
    - d0[2] + NET d0[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 20470 23757 ) N ;
    - d0[3] + NET d0[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 18020 ) N ;
    - d1[0] + NET d1[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - d1[1] + NET d1[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 18630 242 ) N ;
    - d1[2] + NET d1[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 8500 ) N ;
    - d1[3] + NET d1[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 14030 23757 ) N ;
    - sel + NET sel + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 19380 ) N ;
    - y[0] + NET y[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 5750 242 ) N ;
    - y[1] + NET y[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 2070 23757 ) N ;
    - y[2] + NET y[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 8510 23757 ) N ;
    - y[3] + NET y[3] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 1700 ) N ;
END PINS
NETS 13 ;
    - d0[0] ( PIN d0[0] ) ( _2_ A0 ) + USE SIGNAL ;
    - d0[1] ( PIN d0[1] ) ( _1_ A0 ) + USE SIGNAL ;
    - d0[2] ( PIN d0[2] ) ( _0_ A0 ) + USE SIGNAL ;
    - d0[3] ( PIN d0[3] ) ( _3_ A0 ) + USE SIGNAL ;
    - d1[0] ( PIN d1[0] ) ( _2_ A1 ) + USE SIGNAL ;
    - d1[1] ( PIN d1[1] ) ( _1_ A1 ) + USE SIGNAL ;
    - d1[2] ( PIN d1[2] ) ( _0_ A1 ) + USE SIGNAL ;
    - d1[3] ( PIN d1[3] ) ( _3_ A1 ) + USE SIGNAL ;
    - sel ( PIN sel ) ( _3_ S ) ( _2_ S ) ( _1_ S ) ( _0_ S ) + USE SIGNAL ;
    - y[0] ( PIN y[0] ) ( _2_ X ) + USE SIGNAL ;
    - y[1] ( PIN y[1] ) ( _1_ X ) + USE SIGNAL ;
    - y[2] ( PIN y[2] ) ( _0_ X ) + USE SIGNAL ;
    - y[3] ( PIN y[3] ) ( _3_ X ) + USE SIGNAL ;
END NETS
END DESIGN
