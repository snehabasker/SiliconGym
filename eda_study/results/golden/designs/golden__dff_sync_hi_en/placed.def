VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN dff_sync_hi_en ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 25220 25220 ) ;
ROW ROW_0 unithd 2300 2720 N DO 45 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 45 BY 1 STEP 460 0 ;
