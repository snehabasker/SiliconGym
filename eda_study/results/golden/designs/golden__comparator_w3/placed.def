VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN comparator_w3 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 12 ;
    - _09_ sky130_fd_sc_hd__nor2b_1 + PLACED ( 15640 10880 ) FS ;
    - _10_ sky130_fd_sc_hd__nand2b_1 + PLACED ( 8740 8160 ) N ;
    - _11_ sky130_fd_sc_hd__nand2b_1 + PLACED ( 5520 10880 ) FS ;
    - _12_ sky130_fd_sc_hd__nor2b_1 + PLACED ( 17940 10880 ) FS ;
    - _13_ sky130_fd_sc_hd__nor2b_1 + PLACED ( 11040 8160 ) N ;
    - _14_ sky130_fd_sc_hd__nor2_1 + PLACED ( 11040 13600 ) N ;
    - _15_ sky130_fd_sc_hd__a211oi_1 + PLACED ( 9660 10880 ) FS ;
    - _16_ sky130_fd_sc_hd__or2_0 + PLACED ( 16560 8160 ) N ;
    - _17_ sky130_fd_sc_hd__nand2b_1 + PLACED ( 3220 10880 ) FS ;
    - _18_ sky130_fd_sc_hd__and4b_1 + PLACED ( 6440 13600 ) N ;
    - _19_ sky130_fd_sc_hd__and2_0 + PLACED ( 12420 16320 ) FS ;
    - _20_ sky130_fd_sc_hd__a211oi_1 + PLACED ( 9660 16320 ) FS ;
END COMPONENTS
PINS 9 ;
    - a[0] + NET a[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - a[1] + NET a[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 17710 242 ) N ;
    - a[2] + NET a[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 19550 23757 ) N ;
    - b[0] + NET b[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 18020 ) N ;
    - b[1] + NET b[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 12580 ) N ;
    - b[2] + NET b[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 8510 242 ) N ;
    - eq + NET eq + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 1150 23757 ) N ;
    - gt + NET gt + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 10350 23757 ) N ;
    - lt + NET lt + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 4420 ) N ;
END PINS
NETS 18 ;
    - _00_ ( _20_ C1 ) ( _18_ A_N ) ( _16_ A ) ( _09_ Y ) + USE SIGNAL ;
    - _01_ ( _18_ B ) ( _15_ A1 ) ( _10_ Y ) + USE SIGNAL ;
    - _02_ ( _18_ C ) ( _15_ A2 ) ( _11_ Y ) + USE SIGNAL ;
    - _03_ ( _15_ B1 ) ( _14_ A ) ( _12_ Y ) + USE SIGNAL ;
    - _04_ ( _15_ C1 ) ( _14_ B ) ( _13_ Y ) + USE SIGNAL ;
    - _05_ ( _20_ A1 ) ( _19_ A ) ( _14_ Y ) + USE SIGNAL ;
    - _06_ ( _20_ B1 ) ( _16_ B ) ( _15_ Y ) + USE SIGNAL ;
    - _07_ ( _18_ D ) ( _17_ Y ) + USE SIGNAL ;
    - _08_ ( _20_ A2 ) ( _19_ B ) ( _18_ X ) + USE SIGNAL ;
    - a[0] ( PIN a[0] ) ( _17_ B ) ( _11_ A_N ) + USE SIGNAL ;
    - a[1] ( PIN a[1] ) ( _13_ B_N ) ( _10_ A_N ) + USE SIGNAL ;
    - a[2] ( PIN a[2] ) ( _12_ B_N ) ( _09_ A ) + USE SIGNAL ;
    - b[0] ( PIN b[0] ) ( _17_ A_N ) ( _11_ B ) + USE SIGNAL ;
    - b[1] ( PIN b[1] ) ( _13_ A ) ( _10_ B ) + USE SIGNAL ;
    - b[2] ( PIN b[2] ) ( _12_ A ) ( _09_ B_N ) + USE SIGNAL ;
    - eq ( PIN eq ) ( _19_ X ) + USE SIGNAL ;
    - gt ( PIN gt ) ( _20_ Y ) + USE SIGNAL ;
    - lt ( PIN lt ) ( _16_ X ) + USE SIGNAL ;
END NETS
END DESIGN
