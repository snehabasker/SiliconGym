NETS 25 ;
    - d0[0] ( PIN d0[0] ) ( _6_ A0 ) + USE SIGNAL ;
    - d0[1] ( PIN d0[1] ) ( _5_ A0 ) + USE SIGNAL ;
    - d0[2] ( PIN d0[2] ) ( _4_ A0 ) + USE SIGNAL ;
    - d0[3] ( PIN d0[3] ) ( _3_ A0 ) + USE SIGNAL ;
    - d0[4] ( PIN d0[4] ) ( _2_ A0 ) + USE SIGNAL ;
    - d0[5] ( PIN d0[5] ) ( _1_ A0 ) + USE SIGNAL ;
    - d0[6] ( PIN d0[6] ) ( _0_ A0 ) + USE SIGNAL ;
    - d0[7] ( PIN d0[7] ) ( _7_ A0 ) + USE SIGNAL ;
    - d1[0] ( PIN d1[0] ) ( _6_ A1 ) + USE SIGNAL ;
    - d1[1] ( PIN d1[1] ) ( _5_ A1 ) + USE SIGNAL ;
    - d1[2] ( PIN d1[2] ) ( _4_ A1 ) + USE SIGNAL ;
    - d1[3] ( PIN d1[3] ) ( _3_ A1 ) + USE SIGNAL ;
    - d1[4] ( PIN d1[4] ) ( _2_ A1 ) + USE SIGNAL ;
    - d1[5] ( PIN d1[5] ) ( _1_ A1 ) + USE SIGNAL ;
    - d1[6] ( PIN d1[6] ) ( _0_ A1 ) + USE SIGNAL ;
    - d1[7] ( PIN d1[7] ) ( _7_ A1 ) + USE SIGNAL ;
    - sel ( PIN sel ) ( _7_ S ) ( _6_ S ) ( _5_ S ) ( _4_ S ) ( _3_ S ) ( _2_ S )
      ( _1_ S ) ( _0_ S ) + USE SIGNAL ;
    - y[0] ( PIN y[0] ) ( _6_ X ) + USE SIGNAL ;
    - y[1] ( PIN y[1] ) ( _5_ X ) + USE SIGNAL ;
    - y[2] ( PIN y[2] ) ( _4_ X ) + USE SIGNAL ;
    - y[3] ( PIN y[3] ) ( _3_ X ) + USE SIGNAL ;
    - y[4] ( PIN y[4] ) ( _2_ X ) + USE SIGNAL ;
    - y[5] ( PIN y[5] ) ( _1_ X ) + USE SIGNAL ;
    - y[6] ( PIN y[6] ) ( _0_ X ) + USE SIGNAL ;
    - y[7] ( PIN y[7] ) ( _7_ X ) + USE SIGNAL ;
END NETS
END DESIGN
