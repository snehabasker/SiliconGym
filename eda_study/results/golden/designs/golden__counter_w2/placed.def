VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN counter_w2 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 24000 24000 ) ;
ROW ROW_0 unithd 2300 2720 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 42 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 42 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 2300 19040 N DO 42 BY 1 STEP 460 0 ;
TRACKS X 230 DO 52 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER li1 ;
TRACKS X 170 DO 71 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 71 STEP 340 LAYER met1 ;
TRACKS X 230 DO 52 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 52 STEP 460 LAYER met2 ;
TRACKS X 340 DO 35 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 35 STEP 680 LAYER met3 ;
TRACKS X 460 DO 26 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 26 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 7 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 7 STEP 3400 LAYER met5 ;
COMPONENTS 10 ;
    - _05_ sky130_fd_sc_hd__a21oi_1 + PLACED ( 16560 13600 ) N ;
    - _06_ sky130_fd_sc_hd__and3_1 + PLACED ( 11960 8160 ) N ;
    - _07_ sky130_fd_sc_hd__nor3_1 + PLACED ( 14260 8160 ) N ;
    - _08_ sky130_fd_sc_hd__a21oi_1 + PLACED ( 18400 13600 ) N ;
    - _09_ sky130_fd_sc_hd__o21a_1 + PLACED ( 8740 8160 ) N ;
    - _10_ sky130_fd_sc_hd__dfxtp_1 + PLACED ( 3220 10880 ) FS ;
    - _11_ sky130_fd_sc_hd__dfxtp_1 + PLACED ( 11040 10880 ) FS ;
    - clkbuf_0_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 7360 13600 ) N ;
    - clkbuf_1_0__f_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 2300 2720 ) N ;
    - clkbuf_1_1__f_clk sky130_fd_sc_hd__clkbuf_16 + SOURCE TIMING + PLACED ( 12420 2720 ) N ;
END COMPONENTS
PINS 5 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 400 23460 ) N ;
    - count[0] + NET count[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 230 242 ) N ;
    - count[1] + NET count[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 12580 ) N ;
    - en + NET en + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 15870 23757 ) N ;
    - rst + NET rst + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 15870 242 ) N ;
END PINS
NETS 13 ;
    - _00_ ( _11_ D ) ( _07_ Y ) + USE SIGNAL ;
    - _01_ ( _10_ D ) ( _09_ X ) + USE SIGNAL ;
    - _02_ ( _09_ B1 ) ( _08_ Y ) + USE SIGNAL ;
    - _03_ ( _07_ B ) ( _05_ Y ) + USE SIGNAL ;
    - _04_ ( _07_ C ) ( _06_ X ) + USE SIGNAL ;
    - clk ( PIN clk ) ( clkbuf_0_clk A ) + USE CLOCK ;
    - clknet_0_clk ( clkbuf_1_1__f_clk A ) ( clkbuf_1_0__f_clk A ) ( clkbuf_0_clk X ) + USE CLOCK ;
    - clknet_1_0__leaf_clk ( _10_ CLK ) ( clkbuf_1_0__f_clk X ) + USE CLOCK ;
    - clknet_1_1__leaf_clk ( _11_ CLK ) ( clkbuf_1_1__f_clk X ) + USE CLOCK ;
    - count[0] ( PIN count[0] ) ( _10_ Q ) ( _09_ A1 ) ( _08_ A1 ) ( _06_ A ) ( _05_ A1 ) + USE SIGNAL ;
    - count[1] ( PIN count[1] ) ( _11_ Q ) ( _06_ C ) ( _05_ B1 ) + USE SIGNAL ;
    - en ( PIN en ) ( _09_ A2 ) ( _08_ A2 ) ( _06_ B ) ( _05_ A2 ) + USE SIGNAL ;
    - rst ( PIN rst ) ( _08_ B1 ) ( _07_ A ) + USE SIGNAL ;
END NETS
END DESIGN
