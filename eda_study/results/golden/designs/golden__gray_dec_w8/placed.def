    - g[6] + NET g[6] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 8510 23757 ) N ;
    - g[7] + NET g[7] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met3 ( -400 -150 ) ( 400 150 )
        + PLACED ( 23600 1700 ) N ;
END PINS
NETS 16 ;
    - b[0] ( PIN b[0] ) ( _3_ X ) + USE SIGNAL ;
    - b[1] ( PIN b[1] ) ( _3_ B ) ( _2_ X ) + USE SIGNAL ;
    - b[2] ( PIN b[2] ) ( _2_ B ) ( _1_ X ) + USE SIGNAL ;
    - b[3] ( PIN b[3] ) ( _1_ B ) ( _0_ X ) + USE SIGNAL ;
    - b[4] ( PIN b[4] ) ( _6_ X ) ( _0_ B ) + USE SIGNAL ;
    - b[5] ( PIN b[5] ) ( _6_ B ) ( _5_ X ) + USE SIGNAL ;
    - b[6] ( PIN b[6] ) ( _5_ B ) ( _4_ X ) + USE SIGNAL ;
    - b[7] ( PIN b[7] ) ( _7_ X ) + USE SIGNAL ;
    - g[0] ( PIN g[0] ) ( _3_ A ) + USE SIGNAL ;
    - g[1] ( PIN g[1] ) ( _2_ A ) + USE SIGNAL ;
    - g[2] ( PIN g[2] ) ( _1_ A ) + USE SIGNAL ;
    - g[3] ( PIN g[3] ) ( _0_ A ) + USE SIGNAL ;
    - g[4] ( PIN g[4] ) ( _6_ A ) + USE SIGNAL ;
    - g[5] ( PIN g[5] ) ( _5_ A ) + USE SIGNAL ;
    - g[6] ( PIN g[6] ) ( _4_ B ) + USE SIGNAL ;
    - g[7] ( PIN g[7] ) ( _7_ A ) ( _4_ A ) + USE SIGNAL ;
END NETS
END DESIGN
